const string USER_FILE = "users.txt";
const string EXPENSE_FILE = "expenses.txt";
const string BUDGET_FILE = "budgets.txt";

// Get today's date
string todayDate() {
    time_t now = time(nullptr);
    tm* local = localtime(&now);

    stringstream ss;
    ss << (local->tm_year + 1900) << "-"
       << setw(2) << setfill('0') << (local->tm_mon + 1) << "-"
       << setw(2) << setfill('0') << local->tm_mday;

    return ss.str();
}

// Get current month
string currentMonth() {
    return todayDate().substr(0, 7);
}

// Check leap year
bool isLeapYear(int year) {
    return (year % 400 == 0) ||
           (year % 4 == 0 && year % 100 != 0);
}

// Get number of days in a month
int daysInMonth(int year, int month) {
    if (month == 2)
        return isLeapYear(year) ? 29 : 28;

    if (month == 4 || month == 6 ||
        month == 9 || month == 11)
        return 30;

    return 31;
}

// Validate date format YYYY-MM-DD
bool validDate(const string& date) {
    if (date.size() != 10 ||
        date[4] != '-' || date[7] != '-')
        return false;

    for (int i = 0; i < 10; i++) {
        if (i == 4 || i == 7)
            continue;

        if (!isdigit(static_cast<unsigned char>(date[i])))
            return false;
    }

    int year = stoi(date.substr(0, 4));
    int month = stoi(date.substr(5, 2));
    int day = stoi(date.substr(8, 2));

    if (year < 1900 || month < 1 || month > 12)
        return false;

    return day >= 1 && day <= daysInMonth(year, month);
}

// Validate month format YYYY-MM
bool validMonth(const string& month) {
    if (month.size() != 7 || month[4] != '-')
        return false;

    for (int i = 0; i < 7; i++) {
        if (i == 4)
            continue;

        if (!isdigit(static_cast<unsigned char>(month[i])))
            return false;
    }

    int year = stoi(month.substr(0, 4));
    int m = stoi(month.substr(5, 2));

    return year >= 1900 && m >= 1 && m <= 12;
}

// Register user
bool registerUser() {
    string username, password;

    cout << "\n--- User Registration ---\n";
    cout << "Username: ";
    cin >> username;

    cout << "Password: ";
    cin >> password;

    ifstream in(USER_FILE);
    string u, p;

    while (in >> u >> p) {
        if (u == username) {
            cout << "Username already exists.\n";
            return false;
        }
    }

    in.close();

    ofstream out(USER_FILE, ios::app);

    if (!out) {
        cout << "Unable to open user file.\n";
        return false;
    }

    out << username << " " << password << "\n";

    cout << "Registration successful!\n";
    return true;
}

// Login user
bool loginUser(string& loggedInUser) {
    string username, password, u, p;

    cout << "\n--- Login ---\n";
    cout << "Username: ";
    cin >> username;

    cout << "Password: ";
    cin >> password;

    ifstream in(USER_FILE);

    while (in >> u >> p) {
        if (u == username && p == password) {
            loggedInUser = username;
            cout << "Login successful. Welcome, "
                 << username << "!\n";
            return true;
        }
    }

    cout << "Invalid username or password.\n";
    return false;
}

// Load expenses
vector<Expense> loadExpenses() {
    vector<Expense> all;
    ifstream in(EXPENSE_FILE);

    Expense e;

    while (in >> e.id >> e.username >> e.date
              >> e.category >> e.amount) {

        getline(in, e.description);

        if (!e.description.empty() &&
            e.description[0] == ' ')
            e.description.erase(0, 1);

        if (e.description.empty())
            e.description = "-";

        all.push_back(e);
    }

    return all;
}

// Save expenses
void saveExpenses(const vector<Expense>& all) {
    ofstream out(EXPENSE_FILE);

    if (!out) {
        cout << "Unable to save expenses.\n";
        return;
    }

    for (const auto& e : all) {
        out << e.id << " "
            << e.username << " "
            << e.date << " "
            << e.category << " "
            << fixed << setprecision(2)
            << e.amount << " "
            << e.description << "\n";
    }
}

// Get monthly expense total
double getMonthlyTotal(
    const vector<Expense>& all,
    const string& user,
    const string& month
) {
    double total = 0;

    for (const auto& e : all) {
        if (e.username == user &&
            e.date.size() >= 7 &&
            e.date.substr(0, 7) == month) {
            total += e.amount;
        }
    }

    return total;
}

// Get monthly budget
double getBudget(
    const string& user,
    const string& month
) {
    ifstream in(BUDGET_FILE);

    string u, m;
    double b;

    while (in >> u >> m >> b) {
        if (u == user && m == month)
            return b;
    }

    return 0;
}

// Set monthly budget
void setBudget(const string& user) {
    string month;
    double amount;

    cout << "\nEnter month (YYYY-MM): ";
    cin >> month;

    if (!validMonth(month)) {
        cout << "Invalid month format.\n";
        return;
    }

    cout << "Enter monthly budget: ";

    if (!(cin >> amount) ||
        !cin.good() || amount <= 0) {
        cout << "Invalid budget amount.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    vector<Budget> budgets;

    ifstream in(BUDGET_FILE);
    Budget b;

    while (in >> b.username >> b.month >> b.amount) {
        if (!(b.username == user && b.month == month))
            budgets.push_back(b);
    }

    in.close();

    budgets.push_back({user, month, amount});

    ofstream out(BUDGET_FILE);

    for (const auto& item : budgets) {
        out << item.username << " "
            << item.month << " "
            << item.amount << "\n";
    }

    cout << "Budget saved successfully!\n";
}

// Add expense
void addExpense(const string& user) {
    Expense e;

    vector<Expense> all = loadExpenses();

    e.id = 1;

    for (const auto& x : all)
        e.id = max(e.id, x.id + 1);

    e.username = user;

    cout << "\nDate (YYYY-MM-DD or 0 for today): ";
    cin >> e.date;

    if (e.date == "0")
        e.date = todayDate();

    if (!validDate(e.date)) {
        cout << "Invalid date. Please try again.\n";
        return;
    }

    cout << "Category (Food/Travel/Study/Shopping/Other): ";
    cin >> e.category;

    cout << "Amount: ";

    if (!(cin >> e.amount) || !cin.good() || e.amount <= 0) {
        cout << "Please enter a valid positive amount.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Description: ";
    getline(cin, e.description);

    if (e.description.empty())
        e.description = "-";

    all.push_back(e);

    saveExpenses(all);

    cout << "\nExpense added successfully!\n";

    double budget = getBudget(user, e.date.substr(0, 7));

    if (budget > 0) {
        double total = getMonthlyTotal(
            all, user, e.date.substr(0, 7)
        );

        cout << fixed << setprecision(2);
        cout << "Monthly spending: Rs. " << total
             << " / Rs. " << budget << "\n";

        if (total > budget)
            cout << "WARNING: Monthly budget exceeded!\n";

        else if (total >= budget * 0.80)
            cout << "Alert: You have used 80% or more of your budget.\n";
    }
}

