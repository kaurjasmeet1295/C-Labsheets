// Category-wise report
void categoryReport(const string& user) {
    vector<Expense> all = loadExpenses();

    vector<pair<string, double>> totals;

    for (const auto& e : all) {
        if (e.username == user) {

            auto it = find_if(
                totals.begin(),
                totals.end(),
                [&](const auto& p) {
                    return p.first == e.category;
                }
            );

            if (it == totals.end())
                totals.push_back({e.category, e.amount});
            else
                it->second += e.amount;
        }
    }

    cout << "\n--- Category-wise Expense ---\n";

    if (totals.empty()) {
        cout << "No expenses found.\n";
        return;
    }

    sort(
        totals.begin(),
        totals.end(),
        [](const auto& a, const auto& b) {
            return a.second > b.second;
        }
    );

    for (const auto& p : totals) {
        cout << left << setw(16) << p.first
             << "Rs. " << fixed << setprecision(2)
             << p.second << "\n";
    }
}

// Monthly report
void monthlyReport(const string& user) {
    string month;

    cout << "\nEnter month (YYYY-MM): ";
    cin >> month;

    if (!validMonth(month)) {
        cout << "Invalid month format.\n";
        return;
    }

    vector<Expense> all = loadExpenses();

    double total = getMonthlyTotal(all, user, month);
    double budget = getBudget(user, month);

    cout << "\n--- Monthly Expense Report: "
         << month << " ---\n";

    cout << fixed << setprecision(2);
    cout << "Total expense: Rs. " << total << "\n";

    if (budget > 0) {
        cout << "Budget: Rs. " << budget << "\n";
        cout << "Remaining: Rs. " << budget - total << "\n";

        if (total > budget)
            cout << "Status: Budget exceeded.\n";
        else
            cout << "Status: Within budget.\n";
    }
    else {
        cout << "No budget set for this month.\n";
    }
}

// Expense prediction
void predictExpense(const string& user) {
    string month;

    cout << "\nEnter month (YYYY-MM): ";
    cin >> month;

    if (!validMonth(month)) {
        cout << "Invalid month format.\n";
        return;
    }

    vector<Expense> all = loadExpenses();

    double total = getMonthlyTotal(all, user, month);
    double budget = getBudget(user, month);

    int year = stoi(month.substr(0, 4));
    int m = stoi(month.substr(5, 2));

    int daysPassed = 1;
    int totalDays = daysInMonth(year, m);

    if (month == currentMonth()) {
        time_t now = time(nullptr);
        tm* local = localtime(&now);
        daysPassed = local->tm_mday;
    }
    else if (month < currentMonth()) {
        daysPassed = totalDays;
    }

    double predicted = total / daysPassed * totalDays;

    cout << "\n--- Expense Prediction ---\n";

    cout << fixed << setprecision(2);

    cout << "Recorded spending: Rs. "
         << total << "\n";

    cout << "Estimated month-end spending: Rs. "
         << predicted << "\n";

    if (budget > 0) {
        cout << "Monthly budget: Rs. "
             << budget << "\n";

        if (predicted > budget)
            cout << "Prediction: Budget may be exceeded.\n";
        else
            cout << "Prediction: Likely to stay within budget.\n";
    }
    else {
        cout << "Set a budget to compare the prediction.\n";
    }
}

// Search expense
void searchExpense(const string& user) {
    string key;

    cout << "\nEnter date or category to search: ";
    cin >> key;

    vector<Expense> all = loadExpenses();

    bool found = false;

    for (const auto& e : all) {
        if (e.username == user &&
            (e.date == key || e.category == key)) {

            cout << "ID: " << e.id
                 << " | " << e.date
                 << " | " << e.category
                 << " | Rs. " << fixed << setprecision(2)
                 << e.amount
                 << " | " << e.description << "\n";

            found = true;
        }
    }

    if (!found)
        cout << "No matching expense found.\n";
}

// Delete expense
void deleteExpense(const string& user) {
    int id;

    cout << "\nEnter expense ID to delete: ";

    if (!(cin >> id) || id <= 0) {
        cout << "Invalid ID.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    vector<Expense> all = loadExpenses();

    auto oldSize = all.size();

    all.erase(
        remove_if(
            all.begin(),
            all.end(),
            [&](const Expense& e) {
                return e.username == user && e.id == id;
            }
        ),
        all.end()
    );

    if (all.size() == oldSize) {
        cout << "Expense ID not found.\n";
    }
    else {
        saveExpenses(all);
        cout << "Expense deleted successfully!\n";
    }
}

